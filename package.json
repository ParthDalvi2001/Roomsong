{
  "name": "roomsong",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev up --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:heap": "E2E_HEAP=1 playwright test 27-heap",
    "gallery": "playwright test --config tests/tools/playwright.gallery.config.ts",
    "polish:shots": "POLISH_SHOTS=1 playwright test 99-polish",
    "video:capture": "playwright test --config tests/tools/playwright.video.config.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && node scripts/check-dist.mjs && node scripts/check-size.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "audio:renders": "playwright test -c tests/renders/playwright.config.ts"
  },
  "dependencies": {
    "@iwsdk/core": "1.0.1",
    "@pmndrs/uikit": "1.0.76",
    "@pmndrs/uikit-horizon": "1.0.76",
    "@pmndrs/uikit-lucide": "1.0.76",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@iwsdk/cli": "1.0.1",
    "@iwsdk/reference": "1.0.1",
    "@iwsdk/vite-plugin-dev": "1.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/three": "0.181.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.181.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  },
  "description": "Roomsong: a hands-first mixed-reality music garden for Meta Quest 3 / 3S (WebXR, IWSDK).",
  "license": "UNLICENSED"
}
